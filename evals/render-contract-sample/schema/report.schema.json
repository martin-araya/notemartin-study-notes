{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemartin/schemas/render-degradation.schema.json",
  "schema_version": "1.0.0",
  "title": "Render Degradation Report",
  "description": "Reporte de degradación emitido por un renderer L4 (F53). Refuerza INV-07 y RC-01.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "source_hash", "generated_at", "totals", "degradations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "target": {
      "type": "string",
      "enum": ["obsidian", "notion_api", "notion_md", "appflowy", "markdown", "html_pdf", "flashcards"]
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ir_nodes", "degradations", "content_loss"],
      "properties": {
        "ir_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "degradations": {
          "type": "integer",
          "minimum": 0
        },
        "content_loss": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "degradations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "node_path", "node_type", "capability",
          "alternative", "evidence", "content_intact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^deg-[a-f0-9]{12}$"
          },
          "node_path": {
            "type": "string"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "section", "paragraph", "list", "checklist", "table", "definition-list",
              "code", "console", "equation", "figure", "diagram", "admonition",
              "collapsible", "quote", "columns", "divider", "property-block",
              "question", "step", "parameter-table",
              "text", "strong", "em", "code-inline", "link-external", "link-note",
              "term-ref", "source-ref", "math-inline", "footnote-ref", "keyboard",
              "placeholder", "deleted"
            ]
          },
          "capability": {
            "type": "string"
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "content_intact": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
