    {
      "node": "code",
      "attrs": {
        "lang": "mermaid",
        "text": "erDiagram\n    ARTICLES ||--o{ ARTICLE_TAGS : has\n    ARTICLES {\n        bigserial id PK\n        text title\n        text[] tags\n        integer[] scores\n    }\n    ARTICLE_TAGS {\n        bigint article_id FK\n        text tag\n    }",
        "capability": "code"
      },
      "source_refs": []
    },
    {
      "node": "quote",
      "attrs": {
        "capability": "quote"
      },
      "source_refs": [],
      "children": [
        {
          "node": "text",
          "attrs": {
            "text": "[!note] See also The ERD above shows a hybrid pattern: keep tags as an array for fast lookup, and join with ARTICLE_TAGS only if you need per-tag analytics.",
            "capability": "text"
          },
          "source_refs": []
        }
      ]
    },
    {
