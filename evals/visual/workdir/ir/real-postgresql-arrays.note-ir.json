      },
      "source_refs": [],
      "children": [
        {
          "node": "text",
          "attrs": {
            "text": "Arrays benefit from a GIN (Generalized Inverted Index) index. ",
            "capability": "text"
          },
          "source_refs": []
        },
        {
          "node": "source-ref",
          "attrs": {
            "block_id": "e5f6a7b8c9d0",
