{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemartin.study/schemas/sdm.schema.json",
  "title": "Source Document Model",
  "description": "Modelo jerárquico de la fuente: documento → secciones → bloques. Cada bloque porta un id estable (sha1 de source_hash + section_path + block_index, primeros 12 hex), un tipo, su contenido, un ancla resoluble, confianza y origen. El id y el ancla son inmutables una vez calculado el SDM: cambios en el hash de la fuente invalidan la caché (F36). Documento normativo de Fase 13.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "sections"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Versión del esquema. Versión mayor en cambios incompatibles; menor en campo opcional nuevo (per AGENT.md §7.4)."
    },
    "source": { "$ref": "#/$defs/source" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "source_provenance": {
      "type": "object",
      "description": "F34 — Per-field provenance annotation. Optional; if absent, all non-null source fields are assumed method:read, confidence:1.0.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "confidence"],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "read",
              "web_docs_metadata",
              "triage_metadata",
              "cover_or_header",
              "url_regex",
              "inferred",
              "default",
              "absent"
            ],
            "description": "How this field was obtained. read = user-supplied (--source-meta). inferred family = derived heuristically."
          },
          "value": {
            "description": "Mirror of source[FIELD] (or null). No schema constraint here to allow any value type (string / array / null)."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "[0, 1]. read ⇒ 1.0; inferred family ⇒ <1.0; absent ⇒ 0.0."
          },
          "reason": {
            "type": "string",
            "description": "Optional short hint for how the field was obtained."
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hash", "vendor", "product", "url", "language", "format"],
      "properties": {
        "id":       { "type": "string", "description": "Identificador único de la fuente (e.g. '01-postgresql-chapter')." },
        "hash":     { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 hex del archivo fuente." },
        "algorithm":{ "type": "string", "enum": ["sha256"], "default": "sha256" },
        "vendor":   { "type": "string" },
        "product":  { "type": "string" },
        "version":  { "type": ["string", "null"] },
        "edition":  { "type": ["string", "null"] },
        "authors":  { "type": "array", "items": { "type": "string" } },
        "isbn":     { "type": ["string", "null"], "description": "ISBN o part number, si aplica." },
        "url":      { "type": "string", "format": "uri" },
        "language": { "type": "string", "minLength": 2, "description": "Código BCP-47 (en, es, etc.)." },
        "date":     { "type": ["string", "null"], "format": "date" },
        "format":   { "type": "string", "enum": ["pdf", "html", "epub", "docx", "pptx", "txt", "md", "repo", "transcript"] }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_path", "blocks"],
      "properties": {
        "section_path": { "type": "string", "description": "Ruta canónica estable (e.g. '/ch02/intro' o '§2.1'). Insensible a numeración impresa." },
        "title":        { "type": "string" },
        "blocks":       { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "anchor", "confidence", "origin"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$",
          "description": "sha1(source.hash + section_path + str(block_index))[:12]. Determinista."
        },
        "type":       { "$ref": "#/$defs/blockType" },
        "content":    { "$ref": "#/$defs/blockContent" },
        "anchor":     { "$ref": "#/$defs/anchor" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "origin":     { "type": "string", "enum": ["native", "ocr", "reconstructed"] }
      }
    },
    "blockType": {
      "enum": ["prose", "heading", "list", "table", "code", "console",
               "formula", "figure", "caption", "note", "warning",
               "example", "syntax-diagram", "footnote", "toc", "boilerplate"]
    },
    "blockContent": {
      "description": "Forma de `content` discriminada por `type`. Cada rama if/then fija la estructura esperada para su tipo. Se usa `anyOf` (no `oneOf`) porque las ramas cuyo `if` no coincide se evalúan como vacíamente válidas; el discriminador real es el campo `type` del bloque, ya constreñido por el enum.",
      "anyOf": [
        { "if": { "properties": { "type": { "const": "prose" } }, "required": ["type"] },
          "then": { "type": "string" } },

        { "if": { "properties": { "type": { "const": "heading" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["level", "text"],
                    "properties": {
                      "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                      "text":  { "type": "string" }
                    } } },

        { "if": { "properties": { "type": { "const": "list" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["ordered", "items"],
                    "properties": {
                      "ordered": { "type": "boolean" },
                      "items":   { "type": "array", "items": { "type": "string" } }
                    } } },

        { "if": { "properties": { "type": { "const": "table" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["headers", "rows"],
                    "properties": {
                      "headers": { "type": "array", "items": { "type": "string" } },
                      "rows":    { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
                    } } },

        { "if": { "properties": { "type": { "const": "code" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["lang", "text"],
                    "properties": {
                      "lang": { "type": "string" },
                      "text": { "type": "string" }
                    } } },

        { "if": { "properties": { "type": { "const": "console" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["lines"],
                    "properties": {
                      "lines": { "type": "array", "items": { "type": "string" } }
                    } } },

        { "if": { "properties": { "type": { "const": "formula" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["latex", "display"],
                    "properties": {
                      "latex":  { "type": "string" },
                      "display":{ "type": "boolean" }
                    } } },

        { "if": { "properties": { "type": { "const": "figure" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["src", "alt"],
                    "properties": {
                      "src":     { "type": "string" },
                      "alt":     { "type": "string" },
                      "caption": { "type": "string" }
                    } } },

        { "if": { "properties": { "type": { "const": "caption" } }, "required": ["type"] },
          "then": { "type": "string" } },

        { "if": { "properties": { "type": { "const": "note" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["text"],
                    "properties": {
                      "text":                 { "type": "string" },
                      "severity":             { "type": "string", "enum": ["info", "tip", "novelty", "deprecated"] },
                      "version_introduced":   { "type": "string" }
                    } } },

        { "if": { "properties": { "type": { "const": "warning" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["text"],
                    "properties": {
                      "text":     { "type": "string" },
                      "severity": { "type": "string", "enum": ["caution", "deprecated", "removed"] }
                    } } },

        { "if": { "properties": { "type": { "const": "example" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["text"],
                    "properties": { "text": { "type": "string" } } } },

        { "if": { "properties": { "type": { "const": "syntax-diagram" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["notation", "text"],
                    "properties": {
                      "notation": { "type": "string", "enum": ["railroad", "ebnf"] },
                      "text":     { "type": "string" }
                    } } },

        { "if": { "properties": { "type": { "const": "footnote" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["text", "ref"],
                    "properties": {
                      "text": { "type": "string" },
                      "ref":  { "type": "string" }
                    } } },

        { "if": { "properties": { "type": { "const": "toc" } }, "required": ["type"] },
          "then": { "type": "object", "additionalProperties": false,
                    "required": ["entries"],
                    "properties": {
                      "entries": { "type": "array", "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["label", "page", "anchor"],
                        "properties": {
                          "label":  { "type": "string" },
                          "page":   { "type": ["integer", "null"], "minimum": 1 },
                          "anchor": { "type": "string" }
                        } } }
                    } } },

        { "if": { "properties": { "type": { "const": "boilerplate" } }, "required": ["type"] },
          "then": { "type": "string" } }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "section_path"],
      "properties": {
        "page":         { "type": ["integer", "null"], "minimum": 1,
                          "description": "Número de página (1-based) o null si la fuente no está paginada." },
        "section_path": { "type": "string" },
        "bbox":         { "type": ["array", "null"],
                          "items": { "type": "number" },
                          "minItems": 4, "maxItems": 4,
                          "description": "Bounding box [x, y, w, h] en píxeles o null si no aplica." },
        "char_range":   { "type": ["array", "null"],
                          "items": { "type": "integer" },
                          "minItems": 2, "maxItems": 2,
                          "description": "Rango de caracteres [start, end] dentro del texto extraído." }
      }
    }
  }
}
