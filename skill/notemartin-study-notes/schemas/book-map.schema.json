{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemartin.study/schemas/book-map.schema.json",
  "title": "BookMap",
  "description": "Mapa de un libro: índice de capítulos con dependencias forward/backward, renderizado Mermaid y fecha de generación. Producido por scripts/pipeline/book_mode.py init antes del primer process (BM-R1). Especificación normativa: references/00-pipeline/book-mode.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "generated_at",
    "nodes",
    "edges",
    "mermaid_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "book_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC; debe ser estrictamente menor que chapters[0].started_at (BM-R1)."
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "mermaid_path": {
      "type": "string",
      "description": "Ruta relativa al archivo .mmd dentro del workdir (e.g., 'book_map.mmd')."
    },
    "preface_chapter_id": {
      "type": ["string", "null"],
      "pattern": "^ch[0-9]{2,}$",
      "description": "ID del prefacio si fue detectado."
    },
    "index_unreliable": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ch[0-9]{2,}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "is_preface": { "type": "boolean", "default": false }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "evidence"],
      "properties": {
        "from": { "type": "string", "pattern": "^ch[0-9]{2,}$" },
        "to": { "type": "string", "pattern": "^ch[0-9]{2,}$" },
        "direction": {
          "type": "string",
          "enum": ["forward", "backward"],
          "description": "forward = from aparece antes de to en el libro; backward = referencia hacia un capítulo previo."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Frase literal que sostiene la arista (para auditoría)."
        }
      }
    }
  }
}