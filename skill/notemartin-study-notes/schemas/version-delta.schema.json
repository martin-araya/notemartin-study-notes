{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notemartin.study/schemas/version-delta.schema.json",
  "title": "VersionDelta",
  "description": "Artefacto generado por F111 (Actualización incremental) que documenta las diferencias entre 2 SDMs del mismo source. Documento normativo: references/04-authoring/incremental-update.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delta_id",
    "source_id",
    "old_source_hash",
    "new_source_hash",
    "version",
    "created_at",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "delta_id": {
      "type": "string",
      "pattern": "^vd[0-9]{4,}$",
      "description": "Identificador único del delta (vd0001, vd0002, ...)."
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID de la fuente (semántico; mismo en old + new SDM)."
    },
    "old_source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Versión semver (X.Y o X.Y.Z) extraída del new_sdm.source.version; fallback '1.0'."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "affected_chapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ch[0-9]{2,}$"
      }
    },
    "affected_ir_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "obsoleted_ir_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/deltaChange" }
    },
    "frontmatter": {
      "type": "object",
      "description": "Frontmatter estándar F47 (note-type=version-delta, status, tags, source, source-anchor).",
      "additionalProperties": true
    }
  },
  "$defs": {
    "deltaChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "change_type", "description", "section_path"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
        },
        "change_type": {
          "type": "string",
          "enum": ["added", "removed", "modified", "moved"],
          "description": "added: bloque nuevo. removed: bloque eliminado. modified: text/attrs cambiaron. moved: mismo block_id pero section_path distinto."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Descripción legible del cambio (editable por el agente post-generación)."
        },
        "section_path": {
          "type": "string",
          "minLength": 1
        },
        "block_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}