{
  "$version": "1.0.0",
  "$description": "Design tokens canónicos de notemartin-study-notes (F72). Fuente única para color, tipografía, espaciado, radios y pesos. INV-14: ningún archivo del proyecto contiene un color literal fuera de este archivo. La migración retroactiva de `references/08-render/html_pdf.template.css` queda pendiente para F74 (wiring explícito en `references/07-visual/tokens.md` §10).",
  "typography": {
    "families": {
      "serif": ["Lora", "IBM Plex Serif", "Georgia", "Times New Roman", "serif"],
      "sans": ["Inter", "Helvetica Neue", "Arial", "sans-serif"],
      "mono": ["JetBrains Mono", "Fira Code", "Consolas", "monospace"]
    },
    "scale": {
      "xs":   "0.75rem",
      "sm":   "0.875rem",
      "base": "1rem",
      "md":   "1rem",
      "lg":   "1.25rem",
      "xl":   "1.6rem",
      "2xl":  "2.2rem",
      "3xl":  "2.8rem"
    },
    "weights": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "lineHeights": {
      "tight":  1.25,
      "snug":   1.4,
      "normal": 1.7,
      "loose":  2.0
    }
  },
  "spacing": {
    "scale": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.5rem",
      "6": "2rem",
      "7": "2.5rem",
      "8": "3rem"
    },
    "density": {
      "compact":  { "paragraph": "1", "list-item": "2", "section": "5" },
      "normal":   { "paragraph": "4", "list-item": "4", "section": "6" },
      "spacious": { "paragraph": "6", "list-item": "5", "section": "7" }
    }
  },
  "radii": {
    "none": "0",
    "sm":   "2px",
    "md":   "4px",
    "lg":   "6px",
    "xl":   "12px",
    "pill": "9999px"
  },
  "_neutral": {
    "text":        { "light": "#1F2328", "dark": "#E6E6E6" },
    "textMuted":   { "light": "#57606A", "dark": "#A8B0B8" },
    "background":  { "light": "#FFFFFF", "dark": "#1E1E1E" },
    "surface":     { "light": "#F5F7FA", "dark": "#252525" },
    "border":      { "light": "#DDE2E8", "dark": "#3A3A3A" },
    "code":        { "light": "#F5F5F5", "dark": "#1E1E2E" },
    "codeText":    { "light": "#1F2328", "dark": "#CDD6F4" },
    "quote":       { "light": "#FAFBFC", "dark": "#2A2A2A" },
    "quoteBorder": { "light": "#B0BEC5", "dark": "#546E7A" }
  },
  "semantic": {
    "info": {
      "_doc": "consejo neutro, etiqueta de versión",
      "light": { "fg": "#0D47A1", "bg": "#E3F2FD", "border": "#1976D2", "fgOnBg": "#0D47A1", "borderContrast": "#0D47A1" },
      "dark":  { "fg": "#82B1FF", "bg": "#0D2747", "border": "#1976D2", "fgOnBg": "#E3F2FD", "borderContrast": "#82B1FF" }
    },
    "success": {
      "_doc": "logro, consejo positivo",
      "light": { "fg": "#1B5E20", "bg": "#E8F5E9", "border": "#2E7D32", "fgOnBg": "#1B5E20", "borderContrast": "#1B5E20" },
      "dark":  { "fg": "#81C784", "bg": "#10331A", "border": "#2E7D32", "fgOnBg": "#E8F5E9", "borderContrast": "#81C784" }
    },
    "warning": {
      "_doc": "atención no destructiva, contradicción",
      "light": { "fg": "#5D2E00", "bg": "#FFF8E1", "border": "#F57C00", "fgOnBg": "#5D2E00", "borderContrast": "#E65100" },
      "dark":  { "fg": "#FFB74D", "bg": "#3A2A0A", "border": "#F57C00", "fgOnBg": "#FFF8E1", "borderContrast": "#FFB74D" }
    },
    "danger": {
      "_doc": "atención destructiva, error irrecuperable",
      "light": { "fg": "#B71C1C", "bg": "#FFEBEE", "border": "#C62828", "fgOnBg": "#B71C1C", "borderContrast": "#B71C1C" },
      "dark":  { "fg": "#EF9A9A", "bg": "#3A0F0F", "border": "#C62828", "fgOnBg": "#FFEBEE", "borderContrast": "#EF9A9A" }
    },
    "note": {
      "_doc": "nota informativa neutra",
      "light": { "fg": "#212121", "bg": "#F5F5F5", "border": "#616161", "fgOnBg": "#212121", "borderContrast": "#424242" },
      "dark":  { "fg": "#BDBDBD", "bg": "#2A2A2A", "border": "#757575", "fgOnBg": "#E0E0E0", "borderContrast": "#BDBDBD" }
    },
    "example": {
      "_doc": "ejemplo demostrativo",
      "light": { "fg": "#263238", "bg": "#FAFAFA", "border": "#757575", "fgOnBg": "#263238", "borderContrast": "#37474F" },
      "dark":  { "fg": "#B0BEC5", "bg": "#263238", "border": "#78909C", "fgOnBg": "#ECEFF1", "borderContrast": "#B0BEC5" }
    },
    "deprecated": {
      "_doc": "obsolescencia, versión eliminada",
      "light": { "fg": "#4A148C", "bg": "#F3E5F5", "border": "#7B1FA2", "fgOnBg": "#4A148C", "borderContrast": "#4A148C" },
      "dark":  { "fg": "#CE93D8", "bg": "#2A0F38", "border": "#7B1FA2", "fgOnBg": "#F3E5F5", "borderContrast": "#CE93D8" }
    },
    "security": {
      "_doc": "aviso de seguridad, CVE, secreto",
      "light": { "fg": "#B71C1C", "bg": "#FFEBEE", "border": "#C62828", "fgOnBg": "#B71C1C", "borderContrast": "#B71C1C" },
      "dark":  { "fg": "#EF9A9A", "bg": "#3A0F0F", "border": "#C62828", "fgOnBg": "#FFEBEE", "borderContrast": "#EF9A9A" }
    },
    "performance": {
      "_doc": "aviso de rendimiento, hot-path, latencia",
      "light": { "fg": "#92400E", "bg": "#FFFBEA", "border": "#F9A825", "fgOnBg": "#92400E", "borderContrast": "#B45309" },
      "dark":  { "fg": "#FBBF24", "bg": "#3A2A05", "border": "#F9A825", "fgOnBg": "#FFFBEA", "borderContrast": "#FBBF24" }
    }
  },
  "series": {
    "_doc": "Paleta de series de datos (F70 Okabe-Ito). Colorblind-safe: ΔE CIEL76 ≥ 20 entre pares adyacentes. Inversión light↔dark modelada en `okabe-ito-black` (negro en light, blanco en dark) y en `axisDark` (ejes en tema oscuro).",
    "okabe-ito-orange":         "#E69F00",
    "okabe-ito-sky-blue":       "#56B4E9",
    "okabe-ito-bluish-green":   "#009E73",
    "okabe-ito-yellow":         "#F0E442",
    "okabe-ito-blue":           "#0072B2",
    "okabe-ito-vermillion":     "#D55E00",
    "okabe-ito-reddish-purple": "#CC79A7",
    "okabe-ito-black":          { "light": "#000000", "dark": "#FFFFFF" },
    "axisLight": {
      "axisLine":  "#666666",
      "gridline":  "#E0E0E0",
      "textAxis":  "#333333",
      "title":     "#000000",
      "subtitle":  "#666666",
      "background": "#FFFFFF"
    },
    "axisDark": {
      "axisLine":  "#A0A0A0",
      "gridline":  "#404040",
      "textAxis":  "#CCCCCC",
      "title":     "#FFFFFF",
      "subtitle":  "#A0A8B0",
      "background": "#1E1E1E"
    }
  }
}
